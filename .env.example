# ==============================================================================
# Orchestr — Environment Variables Template
#
# Copy this file to .env.local for local development. Never commit .env.local.
# For production (e.g. Vercel), configure these variables in:
# Project Settings > Environment Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MongoDB Atlas Configuration
# ------------------------------------------------------------------------------
# Atlas connection string (Atlas Dashboard > Database > Connect > Drivers).
# Development: connect to development cluster or database.
# Production: connect to production cluster with dedicated credentials.
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/?retryWrites=true&w=majority

# Target database name (supports MONGODB_DB or MONGODB_DB_NAME).
# Development: orchestr_dev (or local database)
# Production:  orchestr_prod (or orchestr)
MONGODB_DB=orchestr_dev

# Optional: MongoDB connection pool size for serverless functions (default: driver default).
# MONGODB_MAX_POOL_SIZE=10

# ------------------------------------------------------------------------------
# 2. Authentication (Better Auth)
# ------------------------------------------------------------------------------
# Secret key used to sign and encrypt session tokens and cookies.
# Generate a secure 32+ character random secret using: openssl rand -base64 32
BETTER_AUTH_SECRET=<generate-a-random-32+-char-secret>

# Canonical public origin of the application (no trailing slash).
# Development: http://localhost:3000
# Production:  https://your-production-domain.com or https://<app-name>.vercel.app
BETTER_AUTH_URL=http://localhost:3000

# Optional: Comma-separated list of additional trusted origins (e.g. preview deployments).
# BETTER_AUTH_TRUSTED_ORIGINS=https://preview-1.vercel.app,https://preview-2.vercel.app

# ------------------------------------------------------------------------------
# 3. Automated Deadline Reminders / Cron Jobs
# ------------------------------------------------------------------------------
# Secret used to authorize external cron jobs / runners calling:
# POST /api/organizations/[slug]/notifications/reminders
# Pass in request header as 'x-orchestr-cron-secret: <secret>' or 'Authorization: Bearer <secret>'.
# Generate with: openssl rand -base64 32
ORCHESTR_CRON_SECRET=<generate-a-random-32+-char-secret>

# ------------------------------------------------------------------------------
# 4. Distributed Rate Limiting (Configurable Limits & Failure Policies)
# ------------------------------------------------------------------------------
# Maximum requests per 60-second window across distributed serverless instances.
# RATE_LIMIT_AUTH_MAX=10          # Authentication endpoints (sign-in, sign-up)
# RATE_LIMIT_MUTATION_MAX=60      # Resource mutation endpoints (tasks, members, deliverables)
# RATE_LIMIT_BATCH_MAX=10         # Batch & cron endpoints (deadline reminders)
# RATE_LIMIT_API_MAX=120          # General API read endpoints
# RATE_LIMIT_DISABLED=false       # Set to true to disable rate limiting (testing/dev only)

# Rate-limit database failure policies ("fail-closed" or "fail-open"):
# Defines behavior if MongoDB is unreachable during a rate-limit check.
# - fail-closed: Rejects with HTTP 503 (Retry-After: 30) to prevent brute force / batch floods.
# - fail-open:   Permits request to proceed to avoid user disruption during minor DB hiccups.
# RATE_LIMIT_AUTH_FAILURE_POLICY=fail-closed
# RATE_LIMIT_MUTATION_FAILURE_POLICY=fail-open
# RATE_LIMIT_BATCH_FAILURE_POLICY=fail-closed

# Trusted client IP header (optional):
# By default in production, verified platform headers ("x-vercel-forwarded-for", "cf-connecting-ip")
# are trusted. When running behind custom reverse proxies (e.g. Nginx, Traefik), configure:
# TRUSTED_CLIENT_IP_HEADER=x-real-ip

# ------------------------------------------------------------------------------
# 5. Object Storage (Backblaze B2 S3-Compatible Storage)
# ------------------------------------------------------------------------------
# Private cloud storage for media, task attachments, and deliverable files.
# Files are stored as objects in Backblaze B2; metadata is recorded in MongoDB.
# Credentials must remain private and server-side only. Never expose to client.
# B2 S3-compatible API endpoint (default: https://s3.eu-central-003.backblazeb2.com)
B2_ENDPOINT=https://s3.eu-central-003.backblazeb2.com

# Target region for the private bucket (default: eu-central-003)
B2_REGION=eu-central-003

# Target private bucket name (default: orchestr-files)
B2_BUCKET_NAME=orchestr-files

# Backblaze Application Key ID and Application Key (secret)
# Generate from Backblaze B2 Console > Application Keys.
B2_KEY_ID=<your-backblaze-key-id>
B2_APPLICATION_KEY=<your-backblaze-application-key>


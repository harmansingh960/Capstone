# Copy to .env.local and fill in real values. Never commit .env.local.
# On Vercel, set the same variables in Project Settings > Environment Variables.

# MongoDB Atlas connection string (Atlas > Connect > Drivers).
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/?retryWrites=true&w=majority

# Database name used by the app.
MONGODB_DB=orchestr


# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=<generate-a-random-32+-char-secret>

# Public origin of the app (no trailing slash). Locally: http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
